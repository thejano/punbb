# Uploaded avatars: images only, never scripts (index.html stops listings; no Options or php_flag, which need AllowOverride Options)
<IfModule mod_authz_core.c>
	Require all denied
	<FilesMatch "\.(gif|jpe?g|png)$">
		Require all granted
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	Deny from all
	<FilesMatch "\.(gif|jpe?g|png)$">
		Allow from all
	</FilesMatch>
</IfModule>
